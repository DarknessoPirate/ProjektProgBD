<Window x:Class="ProjektProgBD.Views.GameDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjektProgBD.Views"
        mc:Ignorable="d"
        Title="GameDetailsWindow" Height="450" Width="800">

    <Viewbox Height="450" Width="800">
        <Grid Height="450" Width="800">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF984063"/>
                    <GradientStop Color="#FF41436A" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid Margin="0,10,400,301">

                <Border CornerRadius="20, 0, 20, 0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="364" Height="54" Margin="0,42,0,0" BorderBrush="#FFFFBA69" BorderThickness="4,2,4,2">
                    <TextBlock TextWrapping="Wrap" Text="{Binding CurrentGame.Name}" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFFBA69" TextAlignment="Center" Margin="0,0,0,5"/>
                </Border>
                <TextBlock TextWrapping="Wrap" Text="{Binding CurrentGame.Price}" Grid.Column="0" VerticalAlignment="Top" Height="37" Margin="272,0,47,0" FontSize="25" Foreground="#FFFFBA69" TextAlignment="Right"/>
                <TextBlock TextWrapping="Wrap" Text="zł" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="37" Margin="353,0,0,0" Width="37" FontSize="25" TextAlignment="Center" Foreground="#FFFFBA69"/>
            </Grid>
            <Border Width="200" Height="250" Margin="100,137,500,46" CornerRadius="20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="5"/>
                </Border.Effect>
                <Image Source="/Views/desktop-wallpaper-aesthetic-anime-for-laptop-anime-otosection-pink-aesthetic-anime-pc.jpg" Stretch="UniformToFill"/>

            </Border>
            <DataGrid ColumnWidth="*" ItemsSource="{Binding Reviews, Mode=TwoWay}" SelectedItem="{Binding SelectedReview}"
IsReadOnly="True"
CanUserAddRows="False"
AutoGenerateColumns="False"
CanUserDeleteRows="False"
CanUserResizeColumns="False"
CanUserResizeRows="False" HorizontalAlignment="Left" Width="385" Margin="405,10,0,215" RenderTransformOrigin="0.5,0.5">
                <DataGrid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="0.422"/>
                        <RotateTransform/>
                        <TranslateTransform X="0.793"/>
                    </TransformGroup>
                </DataGrid.RenderTransform>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="40"/>
                    <DataGridTextColumn Header="Content" Binding="{Binding Content}" />
                    <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="40"/>
                    <DataGridTextColumn Header="Author" Binding="{Binding User.Name}"  />
                    <DataGridTextColumn Header="Game Title" Binding="{Binding Game.Name}"  />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel HorizontalAlignment="Left" Margin="400,252,0,0" Width="400">
                <StackPanel Orientation="Horizontal" Width="382" Height="29" Margin="0,0,0,5">
                    <TextBlock FontSize="15" Width="315" Height="22" VerticalAlignment="Bottom" Margin="5,0,0,0" Foreground="#FFF64668"><Run Text="Write a review"/><Run Language="pl-pl" Text=":"/><LineBreak/><Run Language="pl-pl"/></TextBlock>
                    <ComboBox ItemsSource="{Binding Ratings}" SelectedValue="{Binding SelectedRating}" Width="55" Height="24" BorderThickness="1,1,0,1" Padding="2" BorderBrush="#FFF64668" Foreground="#FFF64668" SnapsToDevicePixels="True" FontSize="15" Background="{x:Null}"/>

                </StackPanel>
                <Border>

                    <Border CornerRadius="10" BorderBrush="#FFF54567" BorderThickness="1,1,1,1" Width="376">
                        <TextBox FontSize="15" Height="81" VerticalScrollBarVisibility="Auto" Text="{Binding ReviewContent, Mode=TwoWay}" Width="384" TextWrapping="Wrap" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White"/>
                    </Border>
                </Border>
                <Button x:Name="LoginBtn" 
        Content="Submit review" 
        Foreground="White"
        Background="#FFF64668"
        Margin="0,10,0,25"
        Height="35"
        Width="250"
Command="{Binding SubmitReviewCommand}">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="16">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="AliceBlue" TargetName="ButtonBorder"  />
                                                <Setter Property="TextBlock.Foreground" Value="Black"  TargetName="ButtonBorder" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

        </Grid>
    </Viewbox>
</Window>
