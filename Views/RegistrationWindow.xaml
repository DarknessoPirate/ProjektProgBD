<Window x:Class="ProjektProgBD.Views.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjektProgBD.Views"
        mc:Ignorable="d"
        Title="RegistrationWindow" Height="400" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <Label Content="Username"   Margin="10,0,0,0" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="0" Margin="10,0,0,0" Width="100" HorizontalAlignment="Center" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Email"   Margin="10,0,0,0" HorizontalAlignment="Center"/>
            <TextBox Grid.Row="0" Margin="10,0,0,0" Width="100" HorizontalAlignment="Center" Text="{Binding UserEmail, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="BorderBrush" Value="Gray"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
                                        <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="Transparent"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsEmailValid}" Value="1">
                                            <Setter TargetName="border" Property="BorderBrush" Value="Green"/>
                                            <Setter Property="ToolTip" Value="Valid email format"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEmailValid}" Value="0">
                                            <Setter TargetName="border" Property="BorderBrush" Value="Gray"/>
                                            <Setter Property="ToolTip" Value="Invalid email format"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEmailValid}" Value="-1">
                                            <Setter TargetName="border" Property="BorderBrush" Value="Red"/>
                                            <Setter Property="ToolTip" Value="Invalid email format"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <Label Content="Password" Margin="10,0,0,0" HorizontalAlignment="Center"/>
            <PasswordBox x:Name="PasswordBox"  Margin="10,0,0,0" Width="100" HorizontalAlignment="Center"/>
            <Button Content="Register" Height="30" Width="70" Margin="10,10,0,0"
                    Command="{Binding RegisterCommand}" 
                    CommandParameter="{Binding ElementName=PasswordBox}"></Button>
        
        </StackPanel>


    </Grid>
</Window>
