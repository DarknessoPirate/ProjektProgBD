<UserControl x:Class="ProjektProgBD.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjektProgBD.Tools"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:PathConverter x:Key="PathConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,5,0,0">
            <TextBlock Text="Logged in as: " ></TextBlock>
            <TextBlock Text="{Binding CurrentUser.Name, Mode=OneWay}" FontSize="12" />
        </StackPanel>
            <StackPanel  Margin="10,0,0,0" Orientation="Horizontal">
            <TextBlock>Money: </TextBlock>
            <TextBlock Text="{Binding CurrentMoney, Mode=TwoWay}"></TextBlock>
        </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10 0 0 0">
            <TextBlock FontSize="24" Text="Games in DB" Margin="0 0 0 10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <DataGrid ColumnWidth="*" ItemsSource="{Binding Games, Mode=TwoWay}" SelectedItem="{Binding SelectedGame}"
IsReadOnly="True"
CanUserAddRows="False"
AutoGenerateColumns="False"
CanUserDeleteRows="False"
CanUserResizeColumns="False"
CanUserResizeRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Price" Binding="{Binding Price}"  Width="80"/>
                    <DataGridTemplateColumn Header="Cover">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding CoverImagePath, Converter={StaticResource PathConverter}}" Width="50" Height="50" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Height="20" Width="70" Margin="0,10,0,0" Command="{Binding BuyGameCommand}">Buy game</Button>
            
        </StackPanel>


    </Grid>
</UserControl>
