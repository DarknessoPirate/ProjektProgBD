<Window x:Class="ProjektProgBD.Views.ReviewDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:tools="clr-namespace:ProjektProgBD.Tools"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Window.Resources>

        <ResourceDictionary>
            <tools:RatingToColorConverter x:Key="RatingToColorConverter"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SliderStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </Window.Resources>
    <Viewbox Stretch="Fill">
    <Grid>
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF984063"/>
                    <GradientStop Color="#FF41436A" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="Review Manager" FontSize="20" HorizontalAlignment="Center"/>
            <StackPanel Margin="10">
                    <Label Content="Edit your review:" FontSize="12" Foreground="#FFF64668"/>
                    <Border CornerRadius="10" BorderBrush="#FFF54567" BorderThickness="1,1,1,1">
                        <TextBox Text="{Binding ReviewContent}" Height="150" TextWrapping="Wrap" Width="250" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" SelectionBrush="#FFFAC4FF"/>
                    </Border>
                    <Label Content="Rating" FontSize="12" Foreground="#FFF64668"/>
                <StackPanel>
                    <Grid>
                        <ProgressBar Height="18" VerticalAlignment="Center" x:Name="RatingBar"
                              Minimum="1" Maximum="5"
                              
                              Value="{Binding SelectedRating, Mode=TwoWay}" 
                              Foreground="{Binding SelectedRating, Converter={StaticResource RatingToColorConverter}, Mode=OneWay}"/>

                        <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Height="18"
                         Value="{Binding SelectedRating, Mode=TwoWay}" 
                         VerticalAlignment="Center" Background="Transparent"
                         Style="{StaticResource TransparentSliderStyle}"/>
                    </Grid>
                </StackPanel>

            </StackPanel>
                <Button Command="{Binding EditReviewCommand}" Width="200" Height="30" Content="Edit" Margin="10 0 10 0"
                     Foreground="White"
                     Background="#FFF64668">

                    <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FA7F97" TargetName="ButtonBorder"  />
                                            <Setter Property="TextBlock.Foreground" Value="Black"  TargetName="ButtonBorder" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    </Button.Style>
                 </Button>
            </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <Label Content="Selected Review:" FontSize="32"/>
                <Border CornerRadius="20" Height="300"  Background="White">
                <StackPanel HorizontalAlignment="Center" >
                    <TextBlock Text="{Binding NewReviewContent}" FontSize="20" TextWrapping="Wrap" Width="200" MaxHeight="200"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NewRating}" FontSize="20"/>
                            <TextBlock Text="/5" FontSize="20" />
                        </StackPanel>
                   
                    <Image Source="{Binding SelectedReview.Game.CoverImagePath}" Stretch="Fill" Height="120" Width="150" VerticalAlignment="Bottom" Margin="0 20 0 10"/>
                </StackPanel>
                
            </Border>
        </StackPanel>


    </Grid>
    </Viewbox>
</Window>
