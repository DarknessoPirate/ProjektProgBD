<Window x:Class="ProjektProgBD.Views.ReviewDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:tools="clr-namespace:ProjektProgBD.Tools"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Window.Resources>
        <tools:RadiobuttonConverter x:Key="RadiobuttonConverter"/>
    </Window.Resources>
    <Viewbox Stretch="Fill">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF984063"/>
                    <GradientStop Color="#FF41436A" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel>
                <StackPanel.Resources>
                    <Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="AppBar" x:Name="appbar_star" Width="20" Height="20" Clip="F1 M 0,0L 76,0L 76,76L 0,76L 0,0">
                        <Path Width="20" Height="20" Canvas.Left="0" Canvas.Top="0" Stretch="Fill" Fill="#FF000000" Data="F1 M 17.4167,32.25L 32.9107,32.25L 38,18L 43.0893,32.25L 58.5833,32.25L 45.6798,41.4944L 51.4583,56L 38,48.0833L 26.125,56L 30.5979,41.7104L 17.4167,32.25 Z "/>
                    </Canvas>
                    <!-- StarButton Template -->
                    <ControlTemplate x:Key="StarToggleButton" TargetType="{x:Type ToggleButton}">
                        <Canvas
                        Width="27"
                        Height="20"
                        Clip="F1 M 0,0L 76,0L 76,76L 0,76L 0,0">
                        <Path
                        x:Name="ButtonPath"
                        Width="20"
                        Height="20                 "
                        Canvas.Left="2"
                        Canvas.Top="2"
                        Data="F1 M 17.416,32.25L 32.910,32.25L 38,18L 43.089,32.25L 58.583,32.25L 45.679,41.494L 51.458,56L 38,48.083L 26.125,56L 30.597,41.710L 17.416,32.25 Z "
                        Fill="Transparent"
                        Stroke="#FFFFBA69"
                        StrokeThickness="2"
                        Stretch="Fill"/>
                        </Canvas>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="ButtonPath" Property="Fill" Value="#FFFFBA69"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </StackPanel.Resources>
                <TextBlock Text="Review Manager" FontSize="20" HorizontalAlignment="Center"/>
                    <StackPanel Margin="10">
                    <Label Content="Edit your review:" FontSize="12" Foreground="#FFF64668"/>
                    <Border CornerRadius="10" BorderBrush="#FFF54567" BorderThickness="1,1,1,1">
                        <TextBox Text="{Binding ReviewContent}" Height="150" TextWrapping="Wrap" Width="250" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White" SelectionBrush="#FFFAC4FF"/>
                    </Border>
                    <Label Content="Rating" FontSize="12" Foreground="#FFF64668"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="btn1"                       
                    Content="All"
                    GroupName="View"
                    Padding="2"
                    Template="{DynamicResource StarToggleButton}" Height="20"
                    IsChecked="{Binding SelectedRating, Converter={StaticResource RadiobuttonConverter}, ConverterParameter=1}"/>
                        <RadioButton x:Name="btn2"
                    Content="All2"
                    GroupName="View"
                    Padding="2"
                    Template="{DynamicResource StarToggleButton}"
                    IsChecked="{Binding SelectedRating, Converter={StaticResource RadiobuttonConverter}, ConverterParameter=2}">
                        </RadioButton>
                        <RadioButton x:Name="btn3"                                     
                    Content="All3"
                    GroupName="View"
                    Padding="2"
                    Template="{DynamicResource StarToggleButton}" Height="20"
                    IsChecked="{Binding SelectedRating, Converter={StaticResource RadiobuttonConverter}, ConverterParameter=3}"/>
                        <RadioButton x:Name="btn4"
                    Content="All4"
                    GroupName="View"
                    Padding="2"
                    Template="{DynamicResource StarToggleButton}" Height="20"
                    IsChecked="{Binding SelectedRating, Converter={StaticResource RadiobuttonConverter}, ConverterParameter=4}"/>
                        <RadioButton x:Name="btn5"
                    Content="All5"
                    GroupName="View"
                    Padding="2"
                    Template="{DynamicResource StarToggleButton}" Height="20"
                    IsChecked="{Binding SelectedRating, Converter={StaticResource RadiobuttonConverter}, ConverterParameter=5}"/>
                    </StackPanel>
                </StackPanel>
                <Button Command="{Binding EditReviewCommand}" Width="200" Height="30" Content="Edit" Margin="10 0 10 0"
                     Foreground="White"
                     Background="#FFF64668">

                    <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FA7F97" TargetName="ButtonBorder"  />
                                            <Setter Property="TextBlock.Foreground" Value="Black"  TargetName="ButtonBorder" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    </Button.Style>
                 </Button>
            </StackPanel>

        <StackPanel Grid.Column="1" Margin="10">
            <Label Content="Selected Review:" FontSize="32"/>
                <Border CornerRadius="20" Height="300"  Background="White">
                <StackPanel HorizontalAlignment="Center" >
                    <TextBlock Text="{Binding NewReviewContent}" FontSize="16" TextWrapping="Wrap" Width="200" MaxHeight="200"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding NewRating}" FontSize="20"/>
                            <TextBlock Text="/5" FontSize="20" />
                        </StackPanel>
                   
                    <Image Source="{Binding SelectedReview.Game.CoverImagePath}" Stretch="Fill" Height="120" Width="150" VerticalAlignment="Bottom" Margin="0 20 0 10"/>
                </StackPanel>
                
            </Border>
        </StackPanel>


    </Grid>
    </Viewbox>
</Window>
